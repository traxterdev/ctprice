# Environment
.env
.env.*

# CMS — credenciais locais de banco (NUNCA versionar; ver config/database.example.php)
/config/database.local.php

# CMS — uploads administrativos (logos de Clientes/Parceiros). Não dependem do Git em produção —
# a estrutura de diretórios é preservada via .gitkeep (ver docs/cms.md). Regra explícita por
# subpasta (só existem estas duas hoje) — mais simples e menos frágil que um padrão recursivo
# genérico com negação de .gitkeep.
/assets/uploads/clients/*
!/assets/uploads/clients/.gitkeep
/assets/uploads/partners/*
!/assets/uploads/partners/.gitkeep

# Dependencies
node_modules/
/vendor/
# Nota: ancorado na raiz — o projeto não usa Composer. Um "vendor/" sem barra inicial
# ignoraria também assets/vendor/ (ex.: Swiper, armazenado localmente por decisão de
# arquitetura — ver docs/architecture-proposal.md, seção 6).

# Build
dist/
build/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
