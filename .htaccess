# .htaccess — CT Price (raiz pública)
#
# Bloqueia acesso HTTP DIRETO a arquivos/diretórios internos que não são páginas públicas.
# NÃO afeta `require`/`include` do PHP (que lê o filesystem diretamente, nunca via HTTP) nem
# nenhuma página, endpoint de formulário ou asset público legítimo.
#
# Por quê: a arquitetura atual usa a raiz do projeto como DocumentRoot (sem pasta /public/
# separada — ver docs/deploy-production.md, seção "Por que não há /public/ ainda"). Sem estas
# regras, qualquer arquivo físico sob a raiz é servido normalmente se nada o proibir — foi assim
# que a auditoria global encontrou `.git/`, `CLAUDE.md`, `docs/` etc. acessíveis por HTTP
# (docs/reference/global-final-audit.md, achado P0; correção documentada em
# docs/reference/deploy-security-validation.md).
#
# `[NC]` (No Case) em toda regra: o filesystem do Windows/produção pode não diferenciar
# maiúsculas/minúsculas — sem isso, `/CLAUDE.MD` ou `/.GIT/config` poderiam contornar a regra.

# Nunca listar o conteúdo de nenhum diretório sob esta raiz.
Options -Indexes

RewriteEngine On

# --- Redirects 301 de URLs antigas WordPress (P1 — mapeamentos comprovados) ----------------
# Cada redirect vai DIRETO ao destino final (nenhum encadeamento tipo /wp/home/ -> /wp/ -> /).
# Mapeamentos e classificação completa: docs/reference/redirect-plan.md. Lista fechada,
# explícita — de propósito NÃO existe uma regra genérica ^wp/(.*)$ (esconderia URLs antigas sem
# equivalente real atrás de um destino novo também inexistente).
#
# Host do redirect: usa o Host da própria requisição SE ele estiver na mesma allowlist já
# aprovada em ctprice_absolute_url() (config/bootstrap.php) — evita refletir um Host forjado
# (ex.: "evil.com") no cabeçalho Location; qualquer Host fora da allowlist cai no domínio
# canônico de produção. O domínio literal aparece UMA única vez (regra de fallback abaixo), não
# repetido nas 14 regras de redirect.
RewriteCond %{HTTP_HOST} !^(ctprice\.com\.br|www\.ctprice\.com\.br|ctprice\.traxter|localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ - [E=CTPRICE_REDIRECT_HOST:ctprice.com.br]
RewriteCond %{ENV:CTPRICE_REDIRECT_HOST} ^$
RewriteRule ^ - [E=CTPRICE_REDIRECT_HOST:%{HTTP_HOST}]

RewriteRule ^wp/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/ [R=301,L,NC]
RewriteRule ^wp/home/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/ [R=301,L,NC]
RewriteRule ^wp/sobre-nos/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/sobre-nos/ [R=301,L,NC]
RewriteRule ^wp/clientes/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/clientes/ [R=301,L,NC]
RewriteRule ^wp/parcerias/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/parcerias/ [R=301,L,NC]
RewriteRule ^wp/fale-conosco/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/fale-conosco/ [R=301,L,NC]
RewriteRule ^wp/informacoes/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/informacoes/ [R=301,L,NC]
RewriteRule ^wp/trabalhe-conosco/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/trabalhe-conosco/ [R=301,L,NC]
RewriteRule ^wp/ouvidoria/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/ouvidoria/ [R=301,L,NC]
RewriteRule ^wp/depoimentos/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/depoimentos/ [R=301,L,NC]
RewriteRule ^wp/arearestrita/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/arearestrita/ [R=301,L,NC]
RewriteRule ^wp/reforma-trabalhista-volta-a-pauta-do-stf-julgamento-acontece-neste-mes/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/reforma-trabalhista-volta-a-pauta-do-stf-julgamento-acontece-neste-mes/ [R=301,L,NC]
RewriteRule ^wp/receita-federal-e-correios-lancam-portal-de-compras-internacionais/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/receita-federal-e-correios-lancam-portal-de-compras-internacionais/ [R=301,L,NC]
RewriteRule ^wp/hello-world/?$ %{REQUEST_SCHEME}://%{ENV:CTPRICE_REDIRECT_HOST}/hello-world/ [R=301,L,NC]

# --- Controle de versão (histórico completo do repositório) -------------------------------
RewriteRule ^\.git(/|$) - [F,L,NC]

# --- Documentação interna e arquivos de desenvolvimento -----------------------------------
RewriteRule ^docs(/|$) - [F,L,NC]
RewriteRule ^(CLAUDE|README)\.md$ - [F,L,NC]
RewriteRule (^|/)\.env(\..*)?$ - [F,L,NC]
RewriteRule \.log$ - [F,L,NC]
RewriteRule ^\.gitignore$ - [F,L,NC]
RewriteRule ^\.gitattributes$ - [F,L,NC]
RewriteRule ^\.serena(/|$) - [F,L,NC]
RewriteRule ^\.claude(/|$) - [F,L,NC]

# --- Diretórios internos da aplicação (usados só via require/include do PHP, nunca por URL) -
# `blog/` inclui o template compartilhado dos posts (blog/_post-template.php) — os posts em si
# vivem em URLs próprias na raiz (ex.: /hello-world/), não em /blog/. `database/` (migrations SQL
# + scripts CLI do CMS) e `repositories/` (classes de acesso ao banco) são novos nesta sprint,
# mesmo motivo: só usados via require/include do PHP, nunca por URL — ver docs/cms.md.
# IMPORTANTE: `admin/` (painel do CMS) NÃO entra nesta lista — precisa continuar acessível por
# HTTP normalmente (só as próprias páginas de /admin/ decidem quem entra, via sessão — ver
# includes/AdminAuth.php).
RewriteRule ^(config|components|includes|content|blog|database|repositories)(/|$) - [F,L,NC]

# Observação: `.htaccess`/`.htpasswd` já são negados globalmente pela configuração padrão do
# Apache (`<Files ".ht*"> Require all denied </Files>` em httpd.conf) — não duplicado aqui.

# --- Roteamento de posts do blog cadastrados no CMS (banco), sem diretório físico próprio ------
# (sprint CMS 02 — ver docs/cms.md). Os 3 posts históricos continuam com diretório físico próprio
# na raiz (ex.: /hello-world/) e NUNCA passam por esta regra (Apache já resolve `-d` para eles
# antes de chegar aqui). Um post NOVO, criado só no banco via /admin/posts/, não tem diretório —
# esta regra só entra em ação quando NENHUM arquivo/diretório físico responde pela URL, então
# nunca interfere nas 10 institucionais, nos 3 diretórios de post existentes, em admin/, assets/
# ou em qualquer regra já tratada acima. `blog-post.php` (raiz, fora de qualquer diretório
# bloqueado acima) consulta o banco pelo slug — se não existir/não estiver publicado, delega para
# o MESMO 404.php de sempre (nunca inventa conteúdo, nunca transforma uma URL desconhecida em
# artigo). Padrão de um único segmento sem ".": nunca intercepta um asset com extensão faltando.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA,NC]

# --- Página 404 própria (P1) ----------------------------------------------------------------
# 404.php já responde HTTP 404 por si só (http_response_code(404), inclusive em acesso direto);
# esta diretiva só manda o Apache exibi-la para qualquer URL/arquivo físico inexistente, em vez
# da página padrão do servidor. NÃO é um router: uma URL física real continua indo para seu
# próprio diretório/index.php normalmente — só o que não existe cai aqui.
ErrorDocument 404 /404.php
